* text=auto eol=lf
*.cmd text eol=crlf

# Preserve generated geometry and compiled modules byte-for-byte.
*.brep binary
*.step binary
*.stp binary
*.stl binary
*.dll binary

# Benchmark manifests hash raw fixture bytes, including their line endings.
artifacts/benchmarks/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
